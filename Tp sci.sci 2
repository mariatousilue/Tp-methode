function [t, y] = echantillonner(f, a, b, n)
    t = linspace(a, b, n+1);
    y = f(t);
endfunction

// Quadrature des trapezes composee (pas constant)
function I = trapezes(t, y)
    h = t(2) - t(1);
    I = h * (sum(y) - (y(1) + y($)) / 2);
endfunction

// Quadrature de Simpson composee (nombre pair d'intervalles)
function I = simpson(t, y)
    h = t(2) - t(1);
    m = length(y);
    I = h/3 * (y(1) + y(m) + 4*sum(y(2:2:m-1)) + 2*sum(y(3:2:m-2)));
endfunction

